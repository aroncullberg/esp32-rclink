menu "RC link"
choice RCLINK_PROTOCOL
    prompt "Receiver protocol"
    default RCLINK_PROTOCOL_AUTO
config RCLINK_PROTOCOL_AUTO
    bool "Auto (try CRSF, then SBUS)"
config RCLINK_PROTOCOL_CRSF
    bool "CRSF"
config RCLINK_PROTOCOL_SBUS
    bool "SBUS"
endchoice
config RCLINK_SBUS_INVERTED
    bool "Invert SBUS RX"
    default y
config RCLINK_ZERO_LQ_FAILSAFE
    bool "Fail when CRSF uplink quality reaches zero"
    default n
    help
        Mark the link as lost when the receiver reports zero uplink quality,
        and wait for a nonzero report before allowing it to recover.
config RCLINK_UART
    int "UART number"
    range 0 2
    default 1
config RCLINK_TX_PIN
    int "TX GPIO"
    range 0 48
    default 4 if IDF_TARGET_ESP32C3
    default 17
config RCLINK_RX_PIN
    int "RX GPIO"
    range 0 48
    default 5 if IDF_TARGET_ESP32C3
    default 16
config RCLINK_CRSF_BAUD
    int "CRSF baud"
    range 100000 1000000
    default 420000
